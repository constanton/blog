---
import { faLinkedin, faOrcid } from '@fortawesome/free-brands-svg-icons';
import { faRss } from '@fortawesome/free-solid-svg-icons';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const profiles = [
	{ name: 'LinkedIn', href: 'https://www.linkedin.com/in/kostasantonakoglou', icon: faLinkedin },
	{ name: 'ORCID', href: 'https://orcid.org/0000-0002-7436-0506', icon: faOrcid },
];
---

<header>
	<nav>
		<h2>
			<a href="/">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links">
			<HeaderLink href="/">Blog</HeaderLink>
			<HeaderLink href="/projects-publications">Projects/Publications</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://github.com/constanton" target="_blank" rel="noopener noreferrer" title="GitHub">
				<span class="sr-only">Kostas Antonakoglou on GitHub</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path>
				</svg>
			</a>
			{profiles.map((profile) => (
				<a href={profile.href} target="_blank" rel="noopener noreferrer" title={profile.name}>
					<span class="sr-only">Kostas Antonakoglou on {profile.name}</span>
					<svg
						viewBox={`0 0 ${profile.icon.icon[0]} ${profile.icon.icon[1]}`}
						aria-hidden="true"
						width="32"
						height="32"
					>
						{(Array.isArray(profile.icon.icon[4]) ? profile.icon.icon[4] : [profile.icon.icon[4]]).map((pathData) => (
							<path fill="currentColor" d={pathData} />
						))}
					</svg>
				</a>
			))}
			<a href="/rss.xml" title="RSS feed" data-astro-reload>
				<span class="sr-only">Subscribe to Kostas Antonakoglou's RSS feed</span>
				<svg viewBox={`0 0 ${faRss.icon[0]} ${faRss.icon[1]}`} aria-hidden="true" width="32" height="32">
					{(Array.isArray(faRss.icon[4]) ? faRss.icon[4] : [faRss.icon[4]]).map((pathData) => (
						<path fill="currentColor" d={pathData} />
					))}
				</svg>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1.25em;
		background: linear-gradient(110deg, rgba(220, 239, 232, 0.65), rgba(245, 221, 211, 0.55));
		border-bottom: 1px solid rgb(var(--gray-light));
	}
	h2 {
		margin: 0;
		font-size: 1.25rem;
		line-height: 1.4;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		gap: 0.25rem 1.5rem;
		max-width: 1120px;
		margin: auto;
		padding: 0.5rem 0;
	}
	nav a {
		padding: 0.75em 0.5em;
		color: rgb(var(--black));
		border-bottom: 2px solid transparent;
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.25rem 0.5rem;
		font-size: 0.9375rem;
	}
	.internal-links :global(a:hover) {
		color: var(--accent-dark);
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	.social-links {
		gap: 0.25rem;
		margin-left: auto;
	}
	.social-links svg {
		width: 23px;
		height: 23px;
		flex-shrink: 0;
	}
	.social-links a {
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 44px;
		height: 44px;
		padding: 0;
		border-bottom: 0;
		border-radius: 4px;
	}
	.social-links a:hover {
		color: var(--accent-dark);
		background: rgba(220, 239, 232, 0.55);
	}
	@media (max-width: 720px) {
		header {
			padding: 0 1rem;
		}
		nav {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			gap: 0.5rem 0.75rem;
			padding: 0.75rem 0;
		}
		.internal-links {
			grid-column: 1 / -1;
			grid-row: 2;
			gap: 0.25rem;
		}
		.social-links {
			grid-column: 2;
			grid-row: 1;
			margin-left: 0;
		}
	}
	@media (max-width: 480px) {
		.social-links {
			display: grid;
			grid-template-columns: repeat(2, 44px);
		}
	}
</style>
